# ---------- server ----------
PORT=4000
PUBLIC_URL=http://localhost:4000          # used by the A/B tracking beacon
DATA_DIR=data                             # SQLite DB + screenshots + previews

# ---------- AI (optional — without a key, copy is generated by deterministic templates) ----------
# provider: openai (any OpenAI-compatible endpoint: OpenAI, Gemini, OpenRouter, Groq, Ollama) | anthropic | none
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=                         # optional; defaults to LLM_MODEL
LLM_BASE_URL=https://api.openai.com/v1    # e.g. https://generativelanguage.googleapis.com/v1beta/openai for Gemini
LLM_INPUT_COST_PER_M=0.15                 # USD per 1M input tokens (for the cost-per-run readout)
LLM_OUTPUT_COST_PER_M=0.60

# ---------- competitor search (optional — falls back to a curated Indian D2C seed list) ----------
SEARCH_PROVIDER=auto                      # auto | serpapi | brave | google | seed
SERPAPI_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARCH_COUNTRY=in

# ---------- crawling ----------
CRAWL_USER_AGENT=WishluckLPBuilderBot/1.0 (+https://example.com/bot)
CRAWL_PER_HOST_DELAY_MS=1500
CRAWL_CONCURRENCY=3
MAX_COMPETITORS=10

# ---------- Shopify (dev store) ----------
SHOPIFY_STORE=your-dev-store.myshopify.com
# Either a custom-app Admin API token (shpat_…) …
SHOPIFY_ADMIN_TOKEN=
# … or a Dev Dashboard app's client credentials (token is fetched automatically)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_THEME_ID=                         # numeric id of a duplicated/unpublished theme (auto-detected if empty)
SHOPIFY_ALLOW_LIVE_THEME=false
SHOPIFY_STOREFRONT_PASSWORD=               # dev stores are password-protected: Online Store → Preferences → Password protection

# ---------- quality ----------
RUN_LIGHTHOUSE=true
MIN_DISTANCE_HISTORY=0.35                 # new designs must be at least this far from recent designs in the category
MIN_DISTANCE_SIBLINGS=0.40                # … and from each other
HISTORY_WINDOW=12
