{%- comment -%} LP Builder · Comparison table (facts only) {%- endcomment -%}
{{ 'lp-base.css' | asset_url | stylesheet_tag }}
{%- style -%}
{{ section.settings.heading_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}
#lp-{{ section.id }}{--lp-bg:{{ section.settings.color_bg }};--lp-fg:{{ section.settings.color_text }};--lp-accent:{{ section.settings.color_accent }};--lp-btn:{{ section.settings.color_button }};--lp-btn-fg:{{ section.settings.color_button_text }};--lp-hf:{{ section.settings.heading_font.family }},{{ section.settings.heading_font.fallback_families }};--lp-hw:{{ section.settings.heading_font.weight }};--lp-hs:{{ section.settings.heading_font.style }};--lp-bf:{{ section.settings.body_font.family }},{{ section.settings.body_font.fallback_families }};--lp-bw:{{ section.settings.body_font.weight }};--lp-radius:{{ section.settings.radius }}px;--lp-pt:{{ section.settings.padding_top }}px;--lp-pb:{{ section.settings.padding_bottom }}px;--lp-h-scale:{{ section.settings.heading_scale | divided_by: 100.0 }}}
{%- endstyle -%}
<div id="lp-{{ section.id }}" class="lp lp-compare">
  <div class="lp-wrap">
    <div class="lp-head lp-center">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<div class="lp-muted">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    <div class="lp-compare__scroll">
      <table class="lp-compare__table">
        <thead><tr><th scope="col"><span class="lp-sr">Feature</span></th><th scope="col" class="lp-compare__us">{{ section.settings.col_a }}</th><th scope="col">{{ section.settings.col_b }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              {%- for col in (1..2) -%}
                {%- if col == 1 -%}{%- assign val = block.settings.value_a -%}{%- else -%}{%- assign val = block.settings.value_b -%}{%- endif -%}
                <td{% if col == 1 %} class="lp-compare__us"{% endif %}>
                  {%- case val -%}
                    {%- when 'yes' -%}<span class="lp-yes">{% render 'lp-icon', name: 'check' %}<span class="lp-sr">Yes</span></span>
                    {%- when 'no' -%}<span class="lp-no" aria-label="No">—</span>
                    {%- else -%}{{ val }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}<p class="lp-muted lp-center" style="font-size:.85rem;margin-top:1rem">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>
<style>
.lp-compare__scroll{overflow-x:auto;max-width:860px;margin:0 auto}
.lp-compare__table{width:100%;border-collapse:separate;border-spacing:0;font-size:.95rem;min-width:420px}
.lp-compare__table th,.lp-compare__table td{padding:14px 12px;text-align:center;border-bottom:1px solid color-mix(in srgb,var(--lp-fg) 12%,transparent)}
.lp-compare__table tbody th{text-align:left;font-weight:500}
.lp-compare__table thead th{font-family:var(--lp-hf);font-weight:var(--lp-hw);font-size:1.02rem}
.lp-compare__us{background:color-mix(in srgb,var(--lp-accent) 10%,transparent)}
thead .lp-compare__us{border-radius:var(--lp-radius) var(--lp-radius) 0 0}
.lp-yes{color:var(--lp-accent);display:inline-flex}
.lp-no{color:color-mix(in srgb,var(--lp-fg) 65%,var(--lp-bg))}
</style>
{% schema %}
{
  "name": "LP · Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it compares" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "col_a", "label": "Our column", "default": "Ours" },
    { "type": "text", "id": "col_b", "label": "Other column", "default": "Typical alternative" },
    { "type": "text", "id": "note", "label": "Footnote" },
    {"type":"header","content":"Colours"},
    {"type":"color","id":"color_bg","label":"Background","default":"#ffffff"},
    {"type":"color","id":"color_text","label":"Text","default":"#121212"},
    {"type":"color","id":"color_accent","label":"Accent","default":"#334fb4"},
    {"type":"color","id":"color_button","label":"Button","default":"#121212"},
    {"type":"color","id":"color_button_text","label":"Button text","default":"#ffffff"},
    {"type":"header","content":"Typography"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"assistant_n4"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"assistant_n4"},
    {"type":"range","id":"heading_scale","label":"Heading size","min":80,"max":140,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Spacing & shape"},
    {"type":"range","id":"radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":8},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"unit":"px","default":56},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"unit":"px","default":56}
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
    { "type": "text", "id": "value_a", "label": "Our value", "info": "Type yes / no for icons, or any text.", "default": "yes" },
    { "type": "text", "id": "value_b", "label": "Other value", "default": "no" }
  ] } ],
  "presets": [ { "name": "LP · Comparison", "blocks": [ { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
