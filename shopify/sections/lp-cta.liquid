{%- comment -%} LP Builder · Repeat add-to-cart banner (real form) {%- endcomment -%}
{{ 'lp-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lp-product.js' | asset_url }}" defer></script>
{%- assign p = section.settings.product | default: product -%}
{%- style -%}
{{ section.settings.heading_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}
#lp-{{ section.id }}{--lp-bg:{{ section.settings.color_bg }};--lp-fg:{{ section.settings.color_text }};--lp-accent:{{ section.settings.color_accent }};--lp-btn:{{ section.settings.color_button }};--lp-btn-fg:{{ section.settings.color_button_text }};--lp-hf:{{ section.settings.heading_font.family }},{{ section.settings.heading_font.fallback_families }};--lp-hw:{{ section.settings.heading_font.weight }};--lp-hs:{{ section.settings.heading_font.style }};--lp-bf:{{ section.settings.body_font.family }},{{ section.settings.body_font.fallback_families }};--lp-bw:{{ section.settings.body_font.weight }};--lp-radius:{{ section.settings.radius }}px;--lp-pt:{{ section.settings.padding_top }}px;--lp-pb:{{ section.settings.padding_bottom }}px;--lp-h-scale:{{ section.settings.heading_scale | divided_by: 100.0 }}}
{%- endstyle -%}
<div id="lp-{{ section.id }}" class="lp lp-cta lp-cta--{{ section.settings.layout }}">
  <div class="lp-wrap lp-cta__grid">
    {%- if section.settings.layout == 'split' -%}
      <div class="lp-cta__media">{% render 'lp-image', image: section.settings.image, p: p, index: section.settings.product_image, sizes: '(min-width: 750px) 40vw, 100vw', class: 'lp-cta__img' %}</div>
    {%- endif -%}
    <div class="lp-cta__body">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lp-muted">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'lp-price', p: p %}
      {% render 'lp-buy-form', p: p, sid: section.id, atc_label: section.settings.atc_label, soldout_label: 'Sold out', picker: 'dropdown', show_quantity: false, show_buy_now: false, after_add: section.settings.after_add, main: false %}
      {%- if section.settings.note != blank -%}<p class="lp-cta__note">{% render 'lp-icon', name: 'shield' %} {{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</div>
<style>
.lp-cta__grid{display:grid;gap:24px;align-items:center}
.lp-cta__body{max-width:560px}
.lp-cta--centered .lp-cta__body{margin:0 auto;text-align:center}
.lp-cta--centered .lp-price{justify-content:center}
.lp-cta .lp-select{margin-bottom:10px}
.lp-cta__media{border-radius:var(--lp-radius);overflow:hidden;aspect-ratio:1}
.lp-cta__img{width:100%;height:100%;object-fit:cover}
.lp-cta__note{display:flex;gap:.5em;align-items:center;justify-content:inherit;font-size:.85rem;margin-top:12px}
.lp-cta__note .lp-icon{width:18px;height:18px}
.lp-cta--centered .lp-cta__note{justify-content:center}
@media(min-width:750px){.lp-cta--split .lp-cta__grid{grid-template-columns:1fr 1fr;gap:56px}}
.lp-cta--bar .lp-cta__body{max-width:none;display:grid;gap:12px;align-items:center}
@media(min-width:990px){.lp-cta--bar .lp-cta__body{grid-template-columns:1.4fr auto 1fr}.lp-cta--bar h2{margin:0}.lp-cta--bar .lp-muted,.lp-cta--bar .lp-eyebrow,.lp-cta--bar .lp-cta__note{display:none}}
</style>
{% schema %}
{
  "name": "LP · Add to cart banner",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Only needed outside product templates." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "centered", "options": [ { "value": "centered", "label": "Centred" }, { "value": "split", "label": "With image" }, { "value": "bar", "label": "Slim bar" } ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "product_image", "label": "Product image fallback", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when you are" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "note", "label": "Reassurance note" },
    { "type": "select", "id": "after_add", "label": "After adding to cart", "default": "toast", "options": [ { "value": "toast", "label": "Stay on page" }, { "value": "cart", "label": "Go to cart" } ] },
    {"type":"header","content":"Colours"},
    {"type":"color","id":"color_bg","label":"Background","default":"#ffffff"},
    {"type":"color","id":"color_text","label":"Text","default":"#121212"},
    {"type":"color","id":"color_accent","label":"Accent","default":"#334fb4"},
    {"type":"color","id":"color_button","label":"Button","default":"#121212"},
    {"type":"color","id":"color_button_text","label":"Button text","default":"#ffffff"},
    {"type":"header","content":"Typography"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"assistant_n4"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"assistant_n4"},
    {"type":"range","id":"heading_scale","label":"Heading size","min":80,"max":140,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Spacing & shape"},
    {"type":"range","id":"radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":8},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"unit":"px","default":56},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"unit":"px","default":56}
  ],
  "presets": [ { "name": "LP · Add to cart banner" } ]
}
{% endschema %}
