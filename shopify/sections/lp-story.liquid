{%- comment -%} LP Builder · Story / why (image + text, optional real stats) {%- endcomment -%}
{{ 'lp-base.css' | asset_url | stylesheet_tag }}
{%- assign p = section.settings.product | default: product -%}
{%- style -%}
{{ section.settings.heading_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}
#lp-{{ section.id }}{--lp-bg:{{ section.settings.color_bg }};--lp-fg:{{ section.settings.color_text }};--lp-accent:{{ section.settings.color_accent }};--lp-btn:{{ section.settings.color_button }};--lp-btn-fg:{{ section.settings.color_button_text }};--lp-hf:{{ section.settings.heading_font.family }},{{ section.settings.heading_font.fallback_families }};--lp-hw:{{ section.settings.heading_font.weight }};--lp-hs:{{ section.settings.heading_font.style }};--lp-bf:{{ section.settings.body_font.family }},{{ section.settings.body_font.fallback_families }};--lp-bw:{{ section.settings.body_font.weight }};--lp-radius:{{ section.settings.radius }}px;--lp-pt:{{ section.settings.padding_top }}px;--lp-pb:{{ section.settings.padding_bottom }}px;--lp-h-scale:{{ section.settings.heading_scale | divided_by: 100.0 }}}
{%- endstyle -%}
<div id="lp-{{ section.id }}" class="lp lp-story lp-story--{{ section.settings.layout }}">
  <div class="lp-wrap lp-story__grid">
    {%- if section.settings.show_image -%}
      <div class="lp-story__media">{% render 'lp-image', image: section.settings.image, p: p, index: section.settings.product_image, sizes: '(min-width: 990px) 50vw, 100vw', class: 'lp-story__img' %}</div>
    {%- endif -%}
    <div class="lp-story__text">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="lp-story__body">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <dl class="lp-story__stats">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}><dt>{{ block.settings.value }}</dt><dd>{{ block.settings.label }}</dd></div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="lp-btn{% if section.settings.button_outline %} lp-btn--outline{% endif %}" href="{{ section.settings.button_link | default: '#lp-buy' }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</div>
<style>
.lp-story__grid{display:grid;gap:28px;align-items:center}
.lp-story__media{border-radius:var(--lp-radius);overflow:hidden;aspect-ratio:4/5;max-height:640px}
.lp-story__img,.lp-story__media svg{width:100%;height:100%;object-fit:cover}
.lp-story__body{font-size:1.06rem}
.lp-story__stats{display:flex;flex-wrap:wrap;gap:28px;margin:1.2em 0 1.4em}
.lp-story__stats dt{font:var(--lp-hw) 1.9rem/1 var(--lp-hf);color:var(--lp-accent)}
.lp-story__stats dd{margin:.3em 0 0;font-size:.88rem}
@media(min-width:750px){
  .lp-story--image_left .lp-story__grid,.lp-story--image_right .lp-story__grid{grid-template-columns:1fr 1fr;gap:64px}
  .lp-story--image_right .lp-story__media{order:2}
}
.lp-story--centered .lp-story__grid{max-width:780px;margin:0 auto;text-align:center}
.lp-story--centered .lp-story__media{aspect-ratio:16/9}
.lp-story--centered .lp-story__stats{justify-content:center}
.lp-story--overlay{position:relative;padding:0;overflow:hidden}
.lp-story--overlay .lp-story__grid{display:block;max-width:none;padding:0;position:relative}
.lp-story--overlay .lp-story__media{aspect-ratio:auto;height:min(80vh,720px);max-height:none;border-radius:0}
.lp-story--overlay .lp-story__text{position:absolute;inset:auto 0 0 0;padding:40px max(20px,calc((100vw - 1160px)/2));color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.72) 45%)}
.lp-story--overlay .lp-eyebrow{color:#fff}
@media(max-width:749px){.lp-story--overlay .lp-story__media{height:72vh}}
</style>
{% schema %}
{
  "name": "LP · Story",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Only needed outside product templates." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_left", "options": [
      { "value": "image_left", "label": "Image left" }, { "value": "image_right", "label": "Image right" }, { "value": "centered", "label": "Centred" }, { "value": "overlay", "label": "Text over full-width image" }
    ]},
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "product_image", "label": "Product image to use when no image is picked", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we made this" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story behind the product.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the add to cart button." },
    { "type": "checkbox", "id": "button_outline", "label": "Outline button", "default": false },
    {"type":"header","content":"Colours"},
    {"type":"color","id":"color_bg","label":"Background","default":"#ffffff"},
    {"type":"color","id":"color_text","label":"Text","default":"#121212"},
    {"type":"color","id":"color_accent","label":"Accent","default":"#334fb4"},
    {"type":"color","id":"color_button","label":"Button","default":"#121212"},
    {"type":"color","id":"color_button_text","label":"Button text","default":"#ffffff"},
    {"type":"header","content":"Typography"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"assistant_n4"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"assistant_n4"},
    {"type":"range","id":"heading_scale","label":"Heading size","min":80,"max":140,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Spacing & shape"},
    {"type":"range","id":"radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":8},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"unit":"px","default":56},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"unit":"px","default":56}
  ],
  "blocks": [ { "type": "stat", "name": "Fact / stat", "limit": 4, "settings": [
    { "type": "text", "id": "value", "label": "Value", "default": "100%" }, { "type": "text", "id": "label", "label": "Label", "default": "cotton" }
  ] } ],
  "presets": [ { "name": "LP · Story" } ]
}
{% endschema %}
