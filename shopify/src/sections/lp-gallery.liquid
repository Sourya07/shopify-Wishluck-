{%- comment -%} LP Builder · Image gallery (product images by default, or picked images) {%- endcomment -%}
{{ 'lp-base.css' | asset_url | stylesheet_tag }}
{%- assign p = section.settings.product | default: product -%}
__STYLE__
<div id="lp-{{ section.id }}" class="lp lp-gallery lp-gallery--{{ section.settings.layout }}">
  <div class="lp-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="lp-head lp-center">
        {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="lp-gallery__list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="lp-gallery__item" {{ block.shopify_attributes }}>
            {% render 'lp-image', image: block.settings.image, p: p, index: block.settings.product_image, sizes: '(min-width: 750px) 33vw, 50vw', class: 'lp-gallery__img' %}
            {%- if block.settings.caption != blank -%}<span class="lp-gallery__cap">{{ block.settings.caption }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for media in p.media limit: section.settings.limit -%}
          <li class="lp-gallery__item">{% render 'lp-image', p: p, index: forloop.index, sizes: '(min-width: 750px) 33vw, 50vw', class: 'lp-gallery__img' %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>
<style>
.lp-gallery__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.lp-gallery__item{position:relative;border-radius:var(--lp-radius);overflow:hidden;aspect-ratio:1}
.lp-gallery__img,.lp-gallery__item svg{width:100%;height:100%;object-fit:cover}
.lp-gallery__cap{position:absolute;left:10px;bottom:10px;background:var(--lp-bg);color:var(--lp-fg);font-size:.8rem;padding:.3em .7em;border-radius:99px}
@media(min-width:750px){.lp-gallery--grid .lp-gallery__list{grid-template-columns:repeat(3,1fr);gap:16px}}
.lp-gallery--mosaic .lp-gallery__item:nth-child(5n+1){grid-row:span 2;aspect-ratio:auto}
@media(min-width:750px){.lp-gallery--mosaic .lp-gallery__list{grid-template-columns:repeat(4,1fr)}.lp-gallery--mosaic .lp-gallery__item:nth-child(5n+1){grid-column:span 2}}
.lp-gallery--strip .lp-gallery__list{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}
.lp-gallery--strip .lp-gallery__item{flex:0 0 min(72%,340px);scroll-snap-align:start;aspect-ratio:4/5}
</style>
{% schema %}
{
  "name": "LP · Gallery",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Only needed outside product templates." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [ { "value": "grid", "label": "Grid" }, { "value": "mosaic", "label": "Mosaic" }, { "value": "strip", "label": "Swipe strip" } ] },
    { "type": "range", "id": "limit", "label": "Product images to show (when no blocks)", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A closer look" },
    "__COMMON__"
  ],
  "blocks": [ { "type": "image", "name": "Image", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "product_image", "label": "Product image fallback", "min": 1, "max": 12, "step": 1, "default": 1 },
    { "type": "text", "id": "caption", "label": "Caption" }
  ] } ],
  "presets": [ { "name": "LP · Gallery" } ]
}
{% endschema %}
