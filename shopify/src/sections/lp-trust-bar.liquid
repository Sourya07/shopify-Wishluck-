{%- comment -%} LP Builder · Trust strip {%- endcomment -%}
{{ 'lp-base.css' | asset_url | stylesheet_tag }}
__STYLE__
<div id="lp-{{ section.id }}" class="lp lp-tbar lp-tbar--{{ section.settings.layout }}">
  <div class="lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="lp-sr">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="lp-tbar__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{% render 'lp-icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</div>
<style>
.lp-tbar__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:14px 18px;font-size:.9rem;font-weight:500}
.lp-tbar__list li{display:flex;gap:.6em;align-items:center}
.lp-tbar__list .lp-icon{color:var(--lp-accent)}
@media(min-width:750px){.lp-tbar__list{display:flex;justify-content:space-around;flex-wrap:wrap}}
.lp-tbar--boxed .lp-tbar__list li{background:color-mix(in srgb,var(--lp-fg) 5%,var(--lp-bg));padding:12px 14px;border-radius:var(--lp-radius)}
</style>
{% schema %}
{
  "name": "LP · Trust strip",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "strip", "options": [ { "value": "strip", "label": "Strip" }, { "value": "boxed", "label": "Boxed" } ] },
    { "type": "text", "id": "heading", "label": "Accessible heading", "default": "Why shop with us" },
    "__COMMON__"
  ],
  "blocks": [ { "type": "item", "name": "Trust item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
      { "value": "truck", "label": "Delivery" }, { "value": "cod", "label": "Cash on delivery" }, { "value": "return", "label": "Returns" }, { "value": "star", "label": "Rating" },
      { "value": "shield", "label": "Secure / warranty" }, { "value": "lock", "label": "Secure payment" }, { "value": "leaf", "label": "Natural" }, { "value": "gift", "label": "Gift" }, { "value": "check", "label": "Check" }
    ]},
    { "type": "text", "id": "text", "label": "Text", "default": "Free delivery" }
  ] } ],
  "presets": [ { "name": "LP · Trust strip", "blocks": [ { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
